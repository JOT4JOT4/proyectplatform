# CONFIGURACIÓN DEL SERVIDOR
PORT=3000
NODE_ENV=development

# BASE DE DATOS (Local / Tradicional)
DB_HOST=localhost
DB_PORT=5433
DB_USER=root
DB_PASS=password
DB_NAME=reserve_system_db

# BASE DE DATOS 
# Railway proporciona DATABASE_URL automáticamente si agregas una base de datos PostgreSQL en el mismo proyecto.
# Si se provee, tendrá prioridad sobre las variables individuales anteriores.
DATABASE_URL=postgresql://root:password@localhost:5433/reserve_system_db
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED: true para validar certificados SSL de la BD en producción, false para omitir la validación
DB_SSL_REJECT_UNAUTHORIZED=true

# URLS DE LA APLICACIÓN (Para redirecciones OAuth)
# En producción, configúralas con los dominios públicos respectivos 
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# AUTENTICACIÓN GOOGLE OAUTH
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Token JWT
JWT_SECRET=your_jwt_secret_key

# CONFIGURACIÓN DE CORREOS (El sistema utiliza la API REST de Brevo directamente)
# Nota: Aunque se definan HOST y PORT, el servicio usa fetch hacia la API de Brevo.
# MAIL_PASS debe ser tu Brevo API Key (xkeysib-...).
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=your_smtp_user_id
MAIL_PASS=your_brevo_api_key_here
MAIL_FROM="Sistema de Reservas UCN" <noreply@tuserviciomail.com>
